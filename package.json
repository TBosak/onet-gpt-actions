{
  "name": "onet-gpt-api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:openapi": "bun scripts/validate-openapi.ts",
    "ci": "bun run lint && bun run typecheck && bun run interest-profiler:validate && bun run validate:providers && bun run test && bun run validate:openapi",
    "data:detect": "bun scripts/onet/detect-release.ts",
    "data:prepare": "bun scripts/onet/prepare.ts",
    "data:refresh:remote": "bun scripts/onet/refresh-remote.ts",
    "data:rollback": "bun scripts/onet/rollback.ts",
    "db:migrate:local": "wrangler d1 migrations apply onet-gpt-data --local",
    "db:migrate:remote": "wrangler d1 migrations apply onet-gpt-data --remote",
    "interest-profiler:validate": "bun scripts/validate-interest-profiler.ts",
    "db:upgrade:interest-profiler:remote": "wrangler d1 execute onet-gpt-data --remote --file=migrations/0002_interest_profiler.sql",
    "validate:providers": "bun scripts/validate-provider-boundaries.ts"
  },
  "dependencies": {
    "hono": "4.12.31"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/workers-types": "5.20260722.1",
    "@types/bun": "1.3.14",
    "typescript": "5.8.3",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  }
}
