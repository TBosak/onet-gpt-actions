{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types",
      "@types/bun",
      "vitest/globals"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "scripts",
    "test",
    "vitest.config.ts"
  ]
}
